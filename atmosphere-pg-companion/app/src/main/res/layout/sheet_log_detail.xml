<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSheetAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvSheetStatus"
            style="@style/Text.AtmospherePG.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvSheetSummary"
            style="@style/Text.AtmospherePG.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:id="@+id/sheetRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/btnTech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.AtmospherePG.Overline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teknis" />

            <ImageView
                android:id="@+id/ivTech"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand"
                app:tint="@color/on_surface_variant"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/techRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetRetry"
            style="@style/Widget.AtmospherePG.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Coba Lagi"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetClose"
            style="@style/Widget.AtmospherePG.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tutup" />
    </LinearLayout>
</ScrollView>
